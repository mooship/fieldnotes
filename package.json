{
  "name": "fieldnotes",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "npm run types && npm run typecheck && astro build",
    "deploy": "npm run build && wrangler deploy",
    "dev": "npm run types && astro dev",
    "format": "biome format --write .",
    "lighthouse": "lhci autorun",
    "lint": "biome check --write . && eslint --fix .",
    "lint:check": "biome check . && eslint .",
    "prepare": "lefthook install --force",
    "preview": "npm run types && astro build && wrangler dev",
    "start": "npm run types && astro dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "types": "wrangler types --include-runtime=false",
    "typecheck": "astro sync && tsc --noEmit --runExternalCode"
  },
  "allowScripts": {
    "esbuild": true,
    "lefthook": true,
    "workerd": true
  },
  "devDependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/ts-content-mapper": "^0.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "2.6.4",
    "@eslint/css": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "1.64.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.0.5",
    "astro": "^7.4.4",
    "astro-pagefind": "^2.0.1",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "mdast-util-to-string": "^4.0.0",
    "reading-time": "^1.5.0",
    "rehype-external-links": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "7.1.0-beta",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.157.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "basic-ftp": "^6.2.1",
    "fflate": "0.7.5",
    "glob@^13": "^14.0.2",
    "katex": "^0.18.2",
    "minimatch@^10": "^11.0.1"
  }
}
