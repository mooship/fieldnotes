{
  "name": "fieldnotes",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "pnpm types && astro check && astro build",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "pnpm types && astro dev",
    "format": "prettier --write --experimental-cli src/ package.json",
    "lighthouse": "lhci autorun",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "preview": "pnpm types && astro build && wrangler dev",
    "start": "pnpm types && astro dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "types": "wrangler types --include-runtime=false"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/cloudflare": "^14.4.1",
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/css": "^2.0.1",
    "@eslint/markdown": "^8.0.3",
    "@fontsource/geist": "^5.2.9",
    "@lhci/cli": "^0.15.1",
    "@lucide/astro": "^1.61.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "astro": "^7.4.1",
    "astro-pagefind": "^2.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unicorn": "^78.0.0",
    "happy-dom": "^21.0.4",
    "lefthook": "^2.2.2",
    "mdast-util-to-string": "^4.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "reading-time": "^1.5.0",
    "rehype-external-links": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-smartypants": "^3.0.2",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook",
      "workerd"
    ],
    "overrides": {
      "eslint-plugin-jsx-a11y>eslint": "$eslint"
    }
  }
}
