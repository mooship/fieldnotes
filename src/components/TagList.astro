---
import { getTagSlug } from "../lib/blog";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{tags.length > 0 && (
  <p class="post-tags">
    {tags.map((tag: string, index: number) => (
      <>
        {index > 0 && " / "}
        <a class="nav-link" href={`/blog/tags/${getTagSlug(tag)}`}>
          {tag}
        </a>
      </>
    ))}
  </p>
)}

<style>
  .post-tags {
    margin: var(--s2) 0 0 0;
  }
</style>
