---
import { formatDate, getPostSlug } from "../lib/blog";
import TagList from "./TagList.astro";

const { post, readingTime } = Astro.props;
const slug = getPostSlug(post.id);
---

<li>
  <div class="post-meta">
    <time class="meta-label" datetime={post.data.pubDate.toISOString()}>
      {formatDate(post.data.pubDate)}
    </time>
    {readingTime && <span class="meta-label">{readingTime}</span>}
  </div>
  <div class="post-content">
    <a class="post-title" href={`/blog/${slug}`}>
      {post.data.title}
    </a>
    <p class="post-desc">{post.data.description}</p>
    <TagList tags={post.data.tags} />
  </div>
</li>

<style>
  li {
    display: grid;
    grid-template-columns: 140px 1fr;
    column-gap: var(--s6);
    align-items: baseline;
    padding: var(--s6) 0;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 0;
  }

  @media (max-width: 480px) {
    li {
      grid-template-columns: 1fr;
      row-gap: var(--s2);
    }
  }

  .post-meta {
    display: flex;
    flex-direction: column;
    gap: var(--s1);
  }

  .post-title {
    display: inline-block;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .post-desc {
    margin: var(--s2) 0 0 0;
    font-size: 0.9375rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
</style>
