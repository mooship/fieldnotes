<script>
  import { incrementSessionCount } from "../lib/easter-eggs";

  console.log(
    "%cfieldnotes%c — statically generated, mildly self-aware.",
    "font-weight:700;color:#e2231a;",
    "font-weight:400;"
  );

  const konamiSequence = [
    "ArrowUp",
    "ArrowUp",
    "ArrowDown",
    "ArrowDown",
    "ArrowLeft",
    "ArrowRight",
    "ArrowLeft",
    "ArrowRight",
    "b",
    "a",
  ];
  const konami = { progress: 0 };

  /**
   * Tracks progress through the Konami code across keydowns, ignoring input
   * while focus is in an editable field so typing doesn't trigger it. A
   * wrong key resets progress to 0 rather than rechecking it against the
   * sequence start.
   */
  addEventListener("keydown", (event) => {
    const target = event.target;
    if (
      target instanceof HTMLElement &&
      (target.tagName === "INPUT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable)
    ) {
      return;
    }

    const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
    if (key === konamiSequence[konami.progress]) {
      konami.progress += 1;
      if (konami.progress === konamiSequence.length) {
        konami.progress = 0;
        document.documentElement.classList.add("konami-active");
        setTimeout(() => {
          document.documentElement.classList.remove("konami-active");
        }, 4000);
      }
    } else {
      konami.progress = 0;
    }
  });

  /**
   * Wires the masthead square's click easter egg: each click shows the next
   * message in `markMessages` (cycling via the session click count) and
   * replays the pulse animation. Safe to call on every `astro:page-load`
   * since the wordmark element itself is recreated on each navigation.
   */
  function setupWordmarkEasterEgg() {
    const mark = document.querySelector<HTMLElement>(".wordmark-mark");
    if (!mark) {
      return;
    }

    const markMessages = [
      "still just a square.",
      "solidarity, comrade.",
      "the square remains unmoved.",
      "okay, that's enough.",
    ];

    mark.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const count = incrementSessionCount("fieldnotes:mark-clicks");
      mark.title = markMessages[(count - 1) % markMessages.length];
      mark.classList.remove("mark-pulse");
      requestAnimationFrame(() => {
        mark.classList.add("mark-pulse");
      });
    });
  }

  document.addEventListener("astro:page-load", setupWordmarkEasterEgg);
</script>
