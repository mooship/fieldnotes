---
import Layout from "../layouts/Layout.astro";
import {
  Content as NowContent,
  frontmatter as nowFrontmatter,
} from "../sections/now.md";
import { formatMonthYear, SITE_TITLE } from "../lib/blog";

const lastUpdated = new Date(nowFrontmatter.lastUpdated as string);
const lastUpdatedDisplay = formatMonthYear(lastUpdated);
const lastUpdatedDatetime = lastUpdated.toISOString().slice(0, 7);
---

<Layout
  title={`Now · ${SITE_TITLE}`}
  description="What I'm working on, reading, playing and thinking about."
  windowLabel="now.md"
  type="website"
>
  <div class="page">
    <h1 class="page-title">Now</h1>
    <p class="meta-label updated">
      Last updated:{" "}
      <time datetime={lastUpdatedDatetime}>{lastUpdatedDisplay}</time>
      <small class="updated-note">
        also known as: whenever I last remembered this file exists
      </small>
    </p>
    <NowContent />
    <p class="nownownow">
      This is a <a href="https://nownownow.com/about">now page</a>.
    </p>
    <a href="/" class="nav-link back-link no-print">
      <span aria-hidden="true">&larr;</span> Back
    </a>
  </div>
</Layout>

<style>
  .page {
    margin: auto;
    padding-top: var(--s6);
  }

  .page-title {
    margin-bottom: var(--s2);
  }

  .updated {
    margin: 0 0 var(--s8) 0;
  }

  .updated-note {
    display: block;
    margin-top: var(--s1);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
  }

  .page :global(p) {
    line-height: 1.6;
    margin: 0 0 var(--s4) 0;
  }

  .page :global(ul) {
    padding-left: var(--s6);
    list-style: square;
    margin-top: 0;
  }

  .page :global(li) {
    margin-bottom: var(--s2);
    color: var(--ink);
  }

  .nownownow {
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-top: var(--s8);
  }

  .back-link {
    margin-top: var(--s4);
  }
</style>
