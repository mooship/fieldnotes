---
import Layout1999 from "../../layouts/Layout1999.astro";
---

<Layout1999
  description="Sign the guestbook, in the style of a 1999 personal home page."
>
  <h2>Guestbook</h2>
  <p>
    Sign my guestbook! Entries are shared with everyone who stops by this page —
    please keep it kind.
  </p>

  <form id="guestbook-form" class="guestbook-form">
    <label for="guestbook-name">Your name</label>
    <input
      id="guestbook-name"
      name="name"
      type="text"
      maxlength="40"
      required
    />
    <label for="guestbook-message">Your message</label>
    <textarea id="guestbook-message" name="message" maxlength="280" required
    ></textarea>
    <button type="submit" class="button-link">Sign the Guestbook</button>
    <p
      class="guestbook-status"
      id="guestbook-status"
      role="status"
      aria-live="polite"
    >
    </p>
  </form>

  <div id="guestbook-entries"></div>

  <script>
    import type { GuestbookEntry } from "../../lib/guestbook";

    const entriesContainer =
      document.querySelector<HTMLElement>("#guestbook-entries");
    const form = document.querySelector<HTMLFormElement>("#guestbook-form");
    const status = document.querySelector<HTMLElement>("#guestbook-status");

    function formatEntryDate(iso: string): string {
      return new Date(iso).toLocaleDateString("en-ZA", {
        year: "numeric",
        month: "short",
        day: "numeric",
      });
    }

    function renderEntries(entries: GuestbookEntry[]) {
      if (!entriesContainer) return;
      entriesContainer.textContent = "";
      for (const entry of entries) {
        const details = document.createElement("details");
        details.className = "guestbook-entry";
        details.open = true;

        const summary = document.createElement("summary");
        summary.textContent = `${entry.name} — ${formatEntryDate(entry.createdAt)}`;

        const message = document.createElement("p");
        message.textContent = entry.message;

        details.append(summary, message);
        entriesContainer.append(details);
      }
    }

    async function loadEntries() {
      try {
        const response = await fetch("/api/guestbook");
        if (!response.ok) throw new Error("Failed to load entries.");
        renderEntries(await response.json());
      } catch {
        if (status) {
          status.textContent =
            "Couldn't load the guestbook right now — try refreshing.";
        }
      }
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const name = String(data.get("name") ?? "");
      const message = String(data.get("message") ?? "");

      if (status) status.textContent = "Signing…";

      try {
        const response = await fetch("/api/guestbook", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ name, message }),
        });

        if (!response.ok) {
          const { error } = (await response.json()) as { error?: string };
          if (status) {
            status.textContent =
              error ?? "Please fill in both your name and a message.";
          }
          return;
        }

        form.reset();
        renderEntries(await response.json());
        if (status) {
          status.textContent =
            "Thanks for signing!! Your entry has been added above.";
        }
      } catch {
        if (status) {
          status.textContent = "Couldn't reach the guestbook — try again.";
        }
      }
    });

    await loadEntries();
  </script>
</Layout1999>

<style>
  /*
   * `:global()` here because #guestbook-entries's contents are appended by
   * the script above via `document.createElement`, so they never pick up
   * this component's scoped-style attribute.
   */
  :global(.guestbook-entry) {
    background: #101040;
    border: 1px solid #808080;
    padding: 0.3rem 0.6rem;
    margin-bottom: 0.5rem;
  }

  :global(.guestbook-entry summary) {
    cursor: pointer;
    color: #ffff00;
  }

  .guestbook-form {
    background: #101040;
    border: 2px inset #808080;
    padding: 0.75rem;
    margin-bottom: 1rem;
  }

  .guestbook-form label {
    display: block;
    font-size: 0.85rem;
    margin: 0.5rem 0 0.2rem;
    color: #e0e0ff;
  }

  .guestbook-form input,
  .guestbook-form textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: inherit;
    font-size: 0.9rem;
    background: #000000;
    color: #00ff00;
    border: 2px inset #808080;
    padding: 0.35rem;
  }

  .guestbook-form textarea {
    resize: vertical;
    min-height: 4rem;
  }

  .guestbook-form button {
    margin-top: 0.6rem;
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .guestbook-status {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: #ffff00;
  }
</style>
