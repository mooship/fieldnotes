---
import Layout1999 from "../../layouts/Layout1999.astro";
import { SITE_AUTHOR } from "../../lib/blog";

const pageTitle = `About Me - ${SITE_AUTHOR}'s Home Page`;
const aboutText = `Hi there, and thanks for stopping by!! My name is ${SITE_AUTHOR}, and this is my home on the World Wide Web. I like writing code, keeping my dog company, and arguing about politics in forums that no longer exist.`;
---

<Layout1999
  title={pageTitle}
  description={`About ${SITE_AUTHOR}, in the style of a 1999 personal home page.`}
  active="about"
>
  <h2>About Me</h2>
  <p>{aboutText}</p>
  <p>
    This page used to be the whole website. Now it's an easter egg buried inside
    a much more sensible one. Progress, apparently.
  </p>
  <p>
    A few facts for the record, ICQ-profile style: I live in Pretoria, South
    Africa. My dog, Mico, is a Pekingese mix and my most reliable code reviewer.
    I build things with Astro these days, though in this particular corner of
    the site we're pretending that's still a few years off.
  </p>
  <p>
    Want the non-nostalgic version? <a href="/">Visit the actual site</a>, or
    read <a href="/1999/guestbook">what people have written in the guestbook</a
    >.
  </p>
</Layout1999>
