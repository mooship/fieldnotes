---
import Layout from "../layouts/Layout.astro";
import { Content as UsesContent } from "../sections/uses.md";
import { SITE_TITLE } from "../lib/blog";
---

<Layout
  title={`Uses · ${SITE_TITLE}`}
  description="The hardware and software I use every day."
  type="website"
>
  <div class="page">
    <h1 class="page-title">Uses</h1>
    <UsesContent />
    <a href="/" class="nav-link back-link no-print">
      <span aria-hidden="true">&larr;</span> Back
    </a>
  </div>
</Layout>

<style>
  .page {
    margin: auto;
    padding-top: 1.6rem;
  }

  .page :global(ul) {
    padding-left: 1.5rem;
    list-style: square;
    margin-top: 0;
  }

  .page :global(li) {
    margin-bottom: 0.4rem;
    color: var(--ink);
  }

  .back-link {
    margin-top: 2rem;
  }
</style>
