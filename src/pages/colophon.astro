---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE } from "../lib/blog";
import { Content as ColophonContent } from "../sections/colophon.md";
---

<Layout
  title={`Colophon · ${SITE_TITLE}`}
  description="How this site is built, designed, and hosted."
  windowLabel="colophon.md"
  type="website"
>
  <div class="page">
    <h1 class="page-title">Colophon</h1>
    <ColophonContent />
    <a href="/" class="nav-link back-link no-print">
      <span aria-hidden="true">&larr;</span> Back
    </a>
  </div>
</Layout>

<style>
  .page {
    margin: auto;
    padding-top: var(--s6);
  }

  .page :global(p) {
    line-height: 1.6;
    margin: 0 0 var(--s4) 0;
  }

  .page :global(ul) {
    padding-left: var(--s6);
    list-style: square;
    margin-top: 0;
  }

  .page :global(li) {
    margin-bottom: var(--s2);
    color: var(--ink);
  }

  .back-link {
    margin-top: var(--s8);
  }
</style>
