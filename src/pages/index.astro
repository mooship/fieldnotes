---
import Layout from "../layouts/Layout.astro";
import DesktopWindow from "../components/DesktopWindow.astro";
import { Content as IntroContent } from "../sections/intro.md";
import { Content as PersonalContent } from "../sections/personal.md";
import { Content as OpenSourceContent } from "../sections/opensource.md";
import { Content as SupportContent } from "../sections/support.md";
import { formatDate, getBlogPosts, getPostSlug, SITE_TITLE } from "../lib/blog";

const posts = await getBlogPosts();
const recentPosts = posts.slice(0, 4);
---

<Layout
  title={SITE_TITLE}
  description="Timothy Brits — software developer in Pretoria, South Africa. Writing on software and open source."
  type="website"
  desktop
>
  <main id="main-content" tabindex="-1">
    <DesktopWindow id="welcome" title="About me" position="welcome">
      <div class="desktop-intro">
        <p class="desktop-eyebrow">Personal home</p>
        <h1>Timothy Brits</h1>
        <IntroContent />
        <p class="intro-location">Pretoria, South Africa</p>
      </div>
    </DesktopWindow>
    <DesktopWindow id="writing" title="Writing" position="writing">
      <h2 class="visually-hidden">Writing</h2>
      <p class="desktop-eyebrow">Latest entries</p>
      <ul class="desktop-posts">
        {recentPosts.map((post) => (
          <li>
            <a href={`/blog/${getPostSlug(post.id)}`}>{post.data.title}</a>
            <time datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
          </li>
        ))}
      </ul>
      <a href="/blog">
        All writing <span aria-hidden="true">&rarr;</span>
      </a>
    </DesktopWindow>
    <DesktopWindow id="projects" title="Projects" position="projects">
      <OpenSourceContent />
      <SupportContent />
    </DesktopWindow>
    <DesktopWindow id="personal" title="Personal" position="personal">
      <PersonalContent />
    </DesktopWindow>
  </main>
</Layout>
