---
import Search from "astro-pagefind/components/Search.astro";
import PostListItem from "../../components/PostListItem.astro";
import Layout from "../../layouts/Layout.astro";
import {
  BLOG_DESCRIPTION,
  computeReadingTime,
  formatDate,
  getBlogPosts,
  SITE_TITLE,
} from "../../lib/blog";

const posts = await getBlogPosts();
const postsWithMeta = posts.map((post) => ({
  post,
  readingTime: computeReadingTime(post.body),
}));
const latest = posts[0];
const windowInfo = latest
  ? `${posts.length} posts · latest ${formatDate(latest.data.pubDate)}`
  : undefined;
---

<Layout
  title={`Writing · ${SITE_TITLE}`}
  description={BLOG_DESCRIPTION}
  windowLabel="blog/"
  {windowInfo}
  type="website"
>
  <div class="page">
    <h1 class="page-title">Writing</h1>
    <div class="search-wrapper">
      <Search className="pagefind-ui" />
    </div>
    <a href="/blog/tags" class="nav-link tags-link">
      Browse by tag
    </a>
    {postsWithMeta.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul>
        {postsWithMeta.map(({ post, readingTime }) => (
          <PostListItem post={post} readingTime={readingTime} />
        ))}
      </ul>
    )}
    <a href="/" class="nav-link back-link no-print">
      <span aria-hidden="true">&larr;</span> Back
    </a>
  </div>
</Layout>

<style>
  .page {
    margin: auto;
    padding-top: var(--s6);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s12) 0;
    border-top: 1px solid var(--rule);
  }

  .empty {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .back-link {
    margin-top: var(--s6);
  }

  .search-wrapper {
    min-height: 36px;
    margin-bottom: var(--s6);
  }

  .tags-link {
    display: inline-block;
    margin-bottom: var(--s6);
  }

  .search-wrapper :global(.pagefind-ui) {
    --pf-background: var(--paper);
    --pf-border: var(--ink);
    --pf-border-focus: var(--signal);
    --pf-border-radius: 0;
    --pf-font: var(--font-mono);
    --pf-hover: var(--desktop);
    --pf-input-font-size: 16px;
    --pf-outline-focus: var(--signal);
    --pf-outline-offset: 2px;
    --pf-outline-width: 3px;
    --pf-text: var(--ink);
    --pf-text-muted: var(--ink);
    --pf-text-secondary: var(--ink);
  }
</style>
