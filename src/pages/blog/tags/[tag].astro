---
import PostListItem from "../../../components/PostListItem.astro";
import Layout from "../../../layouts/Layout.astro";
import {
  computeReadingTime,
  getAllTags,
  getBlogPosts,
  getPostsByTag,
  SITE_TITLE,
} from "../../../lib/blog";

export async function getStaticPaths() {
  const posts = await getBlogPosts();
  const tags = getAllTags(posts);
  return tags.map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, posts: getPostsByTag(posts, slug) },
  }));
}

const { tag, posts } = Astro.props;
const postsWithMeta = posts.map((post) => ({
  post,
  readingTime: computeReadingTime(post.body),
}));
---

<Layout
  title={`${tag} · ${SITE_TITLE}`}
  description={`Posts tagged "${tag}" on ${SITE_TITLE}.`}
  windowLabel={`blog/tags/${tag}/`}
  type="website"
>
  <div class="page">
    <p class="meta-label eyebrow">Tag</p>
    <h1 class="page-title">{tag}</h1>
    <ul>
      {postsWithMeta.map(({ post, readingTime }) => (
        <PostListItem post={post} readingTime={readingTime} />
      ))}
    </ul>
    <a href="/blog/tags" class="nav-link back-link no-print">
      <span aria-hidden="true">&larr;</span> All tags
    </a>
  </div>
</Layout>

<style>
  .page {
    margin: auto;
    padding-top: var(--s6);
  }

  .eyebrow {
    margin: 0 0 var(--s2) 0;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s12) 0;
    border-top: 1px solid var(--rule);
  }

  .back-link {
    margin-top: var(--s6);
  }
</style>
