---
import Layout from "../../../layouts/Layout.astro";
import {
  BLOG_DESCRIPTION,
  getAllTags,
  getBlogPosts,
  SITE_TITLE,
} from "../../../lib/blog";

const posts = await getBlogPosts();
const tags = getAllTags(posts);
---

<Layout
  title={`Tags · ${SITE_TITLE}`}
  description={BLOG_DESCRIPTION}
  windowLabel="blog/tags/"
  type="website"
>
  <div class="page">
    <h1 class="page-title">Tags</h1>
    {tags.length === 0 ? (
      <p class="empty">No tags yet.</p>
    ) : (
      <ul>
        {tags.map(({ tag, slug, count }) => (
          <li>
            <a class="tag-title" href={`/blog/tags/${slug}`}>
              {tag}
            </a>
            <span class="tag-count meta-label">
              {count} {count === 1 ? "post" : "posts"}
            </span>
          </li>
        ))}
      </ul>
    )}
    <a href="/blog" class="nav-link back-link no-print">
      <span aria-hidden="true">&larr;</span> All posts
    </a>
  </div>
</Layout>

<style>
  .page {
    margin: auto;
    padding-top: var(--s6);
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s12) 0;
    border-top: 1px solid var(--rule);
  }

  li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s4);
    padding: var(--s4) 0;
    border-bottom: 1px solid var(--rule);
  }

  .tag-title {
    font-size: 1.1rem;
    font-weight: 600;
  }

  .tag-count {
    flex-shrink: 0;
  }

  .empty {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .back-link {
    margin-top: var(--s6);
  }
</style>
