---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE } from "../lib/blog";
---

<Layout title={`Page not found · ${SITE_TITLE}`} robots="noindex">
  <div class="page">
    <h1 class="page-title">404</h1>
    <p class="c64">
      ?FILE NOT FOUND ERROR
      <br />
      READY.
    </p>
    <p data-role="404-message" hidden></p>
    <nav class="links" aria-label="Suggested pages">
      <ul>
        <li>
          <a href="/">Home</a>
        </li>
        <li>
          <a href="/blog">Writing</a>
        </li>
        <li>
          <a href="/now">Now</a>
        </li>
        <li>
          <a href="/uses">Uses</a>
        </li>
      </ul>
    </nav>
  </div>
</Layout>

<style>
  .page {
    margin: auto;
    padding-top: var(--s6);
  }

  .page-title {
    font-size: 6rem;
    line-height: 1;
    margin-bottom: var(--s2);
  }

  p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0 0 var(--s6) 0;
  }

  .links ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s2);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .links a {
    font-size: 0.95rem;
  }
</style>

<script>
  import { incrementSessionCount } from "../lib/easter-eggs";

  const messages = [
    "This page doesn't exist. It must have been collectivised.",
    "Gone again? At this point it's a pattern, not an accident.",
    "Still not here. Maybe try the sitemap, or acceptance.",
  ];
  const visits = incrementSessionCount("fieldnotes:404-visits");

  const message = document.querySelector<HTMLElement>(
    '[data-role="404-message"]'
  );
  if (message) {
    message.textContent = messages[Math.min(visits, messages.length) - 1];
    message.hidden = false;
  }
</script>
