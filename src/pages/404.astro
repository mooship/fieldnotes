---
import Layout from "../layouts/Layout.astro";
import { SITE_TITLE } from "../lib/blog";
---

<Layout title={`Page not found — ${SITE_TITLE}`} robots="noindex">
  <main id="main-content" tabindex="-1">
    <h1 class="page-title">404</h1>
    <p data-role="404-message">
      This page doesn't exist — it must have been collectivised.
    </p>
    <nav class="links" aria-label="Suggested pages">
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/now">Now</a></li>
        <li><a href="/uses">Uses</a></li>
      </ul>
    </nav>
  </main>
</Layout>

<style>
  main {
    margin: auto;
    padding-top: 1.6rem;
  }

  .page-title {
    font-size: 6rem;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  p {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0 0 1.5rem 0;
  }

  .links ul {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .links a {
    font-size: 0.95rem;
  }
</style>

<script>
  const messages = [
    "This page doesn't exist — it must have been collectivised.",
    "Gone again? At this point it's a pattern, not an accident.",
    "Still not here. Maybe try the sitemap, or acceptance.",
  ];
  const key = "fieldnotes:404-visits";
  const visits = Number(sessionStorage.getItem(key) ?? "0") + 1;
  sessionStorage.setItem(key, String(visits));

  const message = document.querySelector('[data-role="404-message"]');
  if (message) {
    message.textContent = messages[Math.min(visits, messages.length) - 1];
  }
</script>
