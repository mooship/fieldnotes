---
import { SITE_AUTHOR } from "../lib/blog";

const pageTitle = `${SITE_AUTHOR}'s Home Page - Under Construction!`;
const heading = `Welcome to ${SITE_AUTHOR}'s Home Page`;
const aboutText = `Hi there, and thanks for stopping by!! My name is ${SITE_AUTHOR}, and this is my home on the World Wide Web. I like writing code, keeping my dog company, and arguing about politics in forums that no longer exist.`;
const copyrightText = `Copyright 1999 ${SITE_AUTHOR}. All rights reserved.`;
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta
      name="description"
      content="What fieldnotes might have looked like in 1999, before CSS got sensible."
    />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="data:," />
  </head>
  <body>
    <div class="page">
      <center>
        <h1 class="rainbow">
          <span>&#9734;</span>
          {heading}
          <span>&#9734;</span>
        </h1>
        <p class="tagline blink-text">UNDER CONSTRUCTION SINCE 1999</p>
      </center>

      <div class="scroller" role="presentation">
        <div class="scroller-track">
          Hello and welcome to my personal website!! Best viewed at 800x600
          resolution with Netscape Navigator!! Please sign my guestbook before
          you leave!! This site is best experienced with the sound on!!
        </div>
      </div>

      <hr />

      <center>
        <table
          role="presentation"
          class="nav-table"
          border="0"
          cellpadding="0"
          cellspacing="6"
        >
          <tr>
            <td><a class="button-link" href="#about">About Me</a></td>
            <td><a class="button-link" href="#links">Cool Links</a></td>
            <td><a class="button-link" href="#guestbook">Guestbook</a></td>
            <td><a class="button-link" href="#badges">Awards</a></td>
          </tr>
        </table>
      </center>

      <hr />

      <table role="presentation" class="layout-table" width="100%">
        <tr>
          <td style="width: 70%; vertical-align: top;">
            <h2 id="about">About Me</h2>
            <p>{aboutText}</p>
            <p>
              This page used to be the whole website. Now it's an easter egg
              buried inside a much more sensible one. Progress, apparently.
            </p>

            <h2 id="links">Cool Links</h2>
            <p>Check out my webring, powered by the finest dial-up modems:</p>
            <center>
              <table
                role="presentation"
                border="1"
                cellpadding="4"
                cellspacing="0"
                class="webring"
              >
                <tr>
                  <td><a href="/">&larr; Prev Site</a></td>
                  <td><a href="/">&#127922; Random Site</a></td>
                  <td><a href="/">Next Site &rarr;</a></td>
                </tr>
              </table>
              <p class="webring-caption">
                (it's a very small webring — every site in it is this one)
              </p>
            </center>

            <h2 id="guestbook">Guestbook</h2>
            <p>Sign my guestbook! Or just read what other people wrote:</p>
            <details class="guestbook-entry">
              <summary>trace — 14 Feb 1999</summary>
              <p>great site!!! love the background. keep up the good work :)</p>
            </details>
            <details class="guestbook-entry">
              <summary>anonymous — 3 Mar 1999</summary>
              <p>intelligence agencies sign guestbooks too, apparently. hi.</p>
            </details>
            <details class="guestbook-entry">
              <summary>mico (the dog) — undated</summary>
              <p>woof.</p>
            </details>
          </td>
          <td style="width: 30%; vertical-align: top;" class="sidebar">
            <div class="counter-box">
              <p>You are visitor number:</p>
              <div class="counter-digits" id="hit-counter">0000000</div>
            </div>

            <h2 id="badges">Awards &amp; Badges</h2>
            <div class="badge">
              Best viewed in<br />Netscape Navigator 4.0
            </div>
            <div class="badge">800&times;600<br />or better</div>
            <div class="badge">Y2K Compliant<br />&#10003;</div>
            <div class="badge">React-Free<br />Since 1999</div>
          </td>
        </tr>
      </table>

      <hr />

      <center>
        <p class="footer-text">
          {copyrightText}<br />
          This page last updated: never.<br />
          <a href="mailto:webmaster@example.invalid"
            >&#9993; Email the webmaster</a
          >
        </p>
        <p>
          <a href="/" class="escape-link">&larr; Back to the actual site</a>
        </p>
      </center>
    </div>

    <script>
      import { incrementSessionCount } from "../lib/easter-eggs";

      const BASE_VISITORS = 133_700;
      const counter = document.querySelector<HTMLElement>("#hit-counter");
      if (counter) {
        const count =
          BASE_VISITORS + incrementSessionCount("fieldnotes:1999-visits");
        counter.textContent = String(count).padStart(7, "0");
      }
    </script>

    <style>
      :global(html) {
        background: #000080;
      }

      :global(body) {
        margin: 0;
        padding: 1.5rem 1rem;
        background-image:
          radial-gradient(
            circle at 10% 20%,
            rgba(255, 255, 255, 0.15) 0,
            transparent 1px
          ),
          radial-gradient(
            circle at 70% 60%,
            rgba(255, 255, 255, 0.12) 0,
            transparent 1px
          ),
          radial-gradient(
            circle at 40% 85%,
            rgba(255, 255, 255, 0.1) 0,
            transparent 1px
          );
        background-size: 60px 60px;
        background-color: #000080;
        color: #00ff00;
        font-family: "Times New Roman", Times, serif;
      }

      .page {
        max-width: 760px;
        margin: 0 auto;
        background: #000020;
        border: 4px double #c0c0c0;
        padding: 1.25rem;
      }

      h1,
      h2 {
        font-family: "Comic Sans MS", "Comic Sans", cursive, sans-serif;
      }

      h1 {
        color: #ffff00;
        font-size: 2rem;
        margin: 0.5rem 0;
      }

      .rainbow span {
        color: #ff00ff;
      }

      h2 {
        color: #00ffff;
        border-bottom: 2px dashed #ffff00;
        padding-bottom: 0.2rem;
      }

      .tagline {
        color: #ff4040;
        font-weight: bold;
        letter-spacing: 0.05em;
      }

      .blink-text {
        animation: retro-blink 1s steps(1) infinite;
      }

      @keyframes retro-blink {
        50% {
          opacity: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .blink-text {
          animation: none;
        }
      }

      .scroller {
        overflow: hidden;
        background: #000000;
        border: 2px inset #808080;
        padding: 0.4rem 0;
        white-space: nowrap;
      }

      .scroller-track {
        display: inline-block;
        padding-left: 100%;
        color: #00ff00;
        font-family: "Courier New", monospace;
        animation: retro-scroll 18s linear infinite;
      }

      @keyframes retro-scroll {
        from {
          transform: translateX(0);
        }
        to {
          transform: translateX(-100%);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .scroller {
          overflow-x: auto;
        }

        .scroller-track {
          padding-left: 0;
          animation: none;
        }
      }

      hr {
        border: none;
        border-top: 3px groove #c0c0c0;
        margin: 1.25rem 0;
      }

      a {
        color: #ffff00;
      }

      a:visited {
        color: #ff8080;
      }

      .button-link {
        display: inline-block;
        background: #c0c0c0;
        color: #000080;
        font-weight: bold;
        text-decoration: none;
        padding: 0.35rem 0.7rem;
        border: 2px outset #eeeeee;
      }

      .button-link:active {
        border-style: inset;
      }

      p,
      li {
        line-height: 1.5;
        color: #e0e0ff;
      }

      .layout-table td {
        padding: 0 0.75rem;
      }

      .webring {
        background: #101040;
        border-color: #808080;
      }

      .webring td {
        padding: 0.3rem 0.6rem;
      }

      .webring-caption {
        font-size: 0.8rem;
        color: #a0a0ff;
        font-style: italic;
      }

      .guestbook-entry {
        background: #101040;
        border: 1px solid #808080;
        padding: 0.3rem 0.6rem;
        margin-bottom: 0.5rem;
      }

      .guestbook-entry summary {
        cursor: pointer;
        color: #ffff00;
      }

      .counter-box {
        text-align: center;
        background: #101040;
        border: 2px inset #808080;
        padding: 0.5rem;
        margin-bottom: 1rem;
      }

      .counter-box p {
        margin: 0 0 0.35rem 0;
        font-size: 0.85rem;
      }

      .counter-digits {
        display: inline-block;
        background: #000000;
        color: #ff0000;
        font-family: "Courier New", monospace;
        font-weight: bold;
        font-size: 1.25rem;
        letter-spacing: 0.15em;
        padding: 0.2rem 0.4rem;
        border: 1px solid #ff0000;
      }

      .badge {
        display: block;
        text-align: center;
        background: #c0c0c0;
        color: #000080;
        font-size: 0.75rem;
        font-weight: bold;
        line-height: 1.3;
        padding: 0.4rem;
        margin-bottom: 0.5rem;
        border: 2px outset #eeeeee;
      }

      .footer-text {
        font-size: 0.85rem;
        color: #a0a0ff;
      }

      .escape-link {
        display: inline-block;
        margin-top: 0.5rem;
        color: #ffffff;
        background: #000000;
        border: 1px solid #ffffff;
        padding: 0.3rem 0.8rem;
        text-decoration: none;
      }
    </style>
  </body>
</html>
