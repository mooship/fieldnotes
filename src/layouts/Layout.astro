---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/typography.css";
import "../styles/code.css";
import "../styles/print.css";
import "../styles/desktop.css";
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import {
  BriefcaseBusiness,
  FileText,
  Folder,
  House,
  Library,
  Monitor,
} from "@lucide/astro";
import DesktopWindow from "../components/DesktopWindow.astro";
import { SITE_AUTHOR, SITE_TITLE } from "../lib/blog";

/**
Props for the site-wide layout: page `<title>`, meta tags, and JSON-LD.
`ogTitle` defaults to `title` and `canonical` defaults to the current URL
when omitted. `type: "article"` adds article-specific JSON-LD fields
(headline, author, publisher, dates) alongside the base WebSite/Article
schema.
*/
export interface Properties {
  title: string;
  ogTitle?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  robots?: string;
  type?: "website" | "article";
  datePublished?: Date;
  dateModified?: Date;
  desktop?: boolean;
}

const {
  title,
  ogTitle = title,
  description,
  image,
  imageAlt,
  canonical: canonicalProperty,
  robots = "index,follow",
  type = "website",
  datePublished,
  dateModified,
  desktop = false,
} = Astro.props as Properties;

const url = Astro.url;
const pathname = url.pathname;
const canonical = canonicalProperty ?? url.origin + url.pathname;
const schemaType = type === "article" ? "Article" : "WebSite";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  name: type === "website" ? SITE_TITLE : ogTitle,
  ...(canonical && { url: canonical }),
  ...(description && { description }),
  ...(image && { image }),
  ...(type === "article" && {
    headline: ogTitle,
    ...(canonical && { mainEntityOfPage: canonical }),
    author: { "@type": "Person", name: SITE_AUTHOR },
    publisher: { "@type": "Person", name: SITE_AUTHOR },
    ...(datePublished && { datePublished: datePublished.toISOString() }),
    ...(dateModified && { dateModified: dateModified.toISOString() }),
  }),
};
---

<!doctype html>
<html lang="en-ZA" data-view="plain">
  <head>
    <meta charset="UTF-8" />
    <!--
      you're reading the source of a statically generated site.
      it's all just markdown and Astro components — nothing hidden
      but a couple of easter eggs. https://github.com/mooship/fieldnotes
    -->
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <meta name="viewport" content="width=device-width, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <meta
      name="theme-color"
      content="#c5bfb1"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#c5bfb1"
      media="(prefers-color-scheme: dark)"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon-32x32.png?v=2"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon-16x16.png?v=2"
    />
    <link rel="shortcut icon" href="/favicon.ico?v=2" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/apple-touch-icon.png?v=2"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={ogTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={type} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:locale" content="en_ZA" />
    {image && (
      <>
        <meta property="og:image" content={image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
      </>
    )}
    <meta
      name="twitter:card"
      content={image ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={ogTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {image && <meta name="twitter:image" content={image} />}
    {image && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link visually-hidden no-print">
      Skip to main content
    </a>
    <header class="os-menubar no-print">
      <a href="/" class="os-brand">
        <span class="os-brand-mark" aria-hidden="true"></span>
        {SITE_TITLE}
      </a>
      <nav class="os-menu" aria-label="Main">
        <a
          href="/blog"
          aria-current={pathname.startsWith("/blog") ? "page" : undefined}
        >
          Writing
        </a>
        <a
          href="/now"
          class="menu-secondary"
          aria-current={pathname === "/now" ? "page" : undefined}
        >
          Now
        </a>
        <a
          href="/work"
          aria-current={pathname === "/work" ? "page" : undefined}
        >
          Work
        </a>
        <a
          href="/uses"
          class="menu-secondary"
          aria-current={pathname === "/uses" ? "page" : undefined}
        >
          Uses
        </a>
        <a
          href="/colophon"
          class="menu-secondary"
          aria-current={pathname === "/colophon" ? "page" : undefined}
        >
          Colophon
        </a>
        <a href={`${pathname}?view=plain`} data-view-toggle>
          Skip the OS
        </a>
      </nav>
    </header>
    <div class="os-desktop">
      <nav class="desktop-icons no-print" aria-label="Desktop">
        {desktop ? (
          <>
            <button type="button" class="desktop-icon" data-open="welcome">
              <House aria-hidden="true" />
              <span>About me</span>
            </button>
            <button type="button" class="desktop-icon" data-open="writing">
              <Folder aria-hidden="true" />
              <span>Writing</span>
            </button>
            <button type="button" class="desktop-icon" data-open="projects">
              <Folder aria-hidden="true" />
              <span>Projects</span>
            </button>
            <button type="button" class="desktop-icon" data-open="personal">
              <FileText aria-hidden="true" />
              <span>Personal</span>
            </button>
          </>
        ) : (
          <>
            <a href="/" class="desktop-icon">
              <House aria-hidden="true" />
              <span>Desktop</span>
            </a>
            <button type="button" class="desktop-icon" data-open="reader">
              <FileText aria-hidden="true" />
              <span>Open page</span>
            </button>
            <a href="/blog" class="desktop-icon">
              <Folder aria-hidden="true" />
              <span>Writing</span>
            </a>
          </>
        )}
        <a href="/now" class="desktop-icon">
          <FileText aria-hidden="true" />
          <span>Now</span>
        </a>
        <a href="/work" class="desktop-icon">
          <BriefcaseBusiness aria-hidden="true" />
          <span>Work</span>
        </a>
        <a href="/uses" class="desktop-icon">
          <Monitor aria-hidden="true" />
          <span>Uses</span>
        </a>
        <a href="/colophon" class="desktop-icon">
          <Library aria-hidden="true" />
          <span>Colophon</span>
        </a>
      </nav>
      <div class="desktop-workspace">
        {desktop ? (
          <slot />
        ) : (
          <DesktopWindow id="reader" title={ogTitle}>
            <slot />
          </DesktopWindow>
        )}
      </div>
    </div>
    <footer class="os-footer no-print">
      <span>Timothy Brits · Pretoria, South Africa</span>
      <nav aria-label="Feed subscriptions">
        <a href="/atom.xml">Atom</a>
        <a href="/rss.xml">RSS</a>
        <a href="/feed.json">JSON</a>
      </nav>
      <span class="visually-hidden" role="status" data-desktop-status></span>
    </footer>
    <script>
      import "../scripts/desktop";
    </script>
  </body>
</html>

<style>
  .skip-link:focus-visible {
    position: fixed;
    top: 1rem;
    left: 1rem;
    width: auto;
    height: auto;
    clip-path: none;
    margin: 0;
    overflow: visible;
    white-space: normal;
    padding: 0.5rem 1rem;
    background: var(--paper);
    color: var(--link);
    border: 2px solid var(--link);
    border-radius: var(--radius);
    font-size: 0.9rem;
    z-index: var(--z-skip-link);
    text-decoration: none;
  }
</style>
