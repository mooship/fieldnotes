{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fieldnotes",

  // Cloudflare Pages, not a Workers deploy: this points wrangler at the
  // same static build Astro already produces (`pnpm build` -> `./dist`).
  // The Git-integrated dashboard pipeline doesn't read this file -- it
  // keeps building/deploying exactly as it already does. This just makes
  // `wrangler pages deploy` available as a CLI/CI alternative and brings
  // the project name/compatibility settings under version control, in
  // line with the other timothybrits.co.za sites.
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"]
}
