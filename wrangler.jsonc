{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fieldnotes",

  // Cloudflare Workers with static assets: astro build (via @astrojs/cloudflare)
  // emits a server entry that serves prerendered pages straight from the
  // assets binding and only runs the guestbook API route (the one page with
  // `prerender = false`) as an actual Worker invocation.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    // Matches astro.config.mjs's trailingSlash: "never" — without this,
    // Workers' default ("auto-trailing-slash") redirects e.g.
    // /1999/guestbook to /1999/guestbook/.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fieldnotes-guestbook",
      "database_id": "730f141e-9d36-4418-8033-8795e3f09aba"
    }
  ],

  // Anonymous guestbook posts are capped at 5 per client IP per 60s window.
  "ratelimits": [
    {
      "name": "GUESTBOOK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],

  "observability": {
    "enabled": true
  },

  "placement": {
    "mode": "smart"
  }
}
